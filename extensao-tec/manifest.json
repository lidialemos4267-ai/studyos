{
  "manifest_version": 3,
  "name": "StudyOS — TEC Concursos",
  "version": "1.0.0",
  "description": "Guarda localmente as questões que você resolve no TEC Concursos (sua resposta, gabarito, comentário) e entrega ao seu StudyOS. Uso pessoal.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.tecconcursos.com.br/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StudyOS — TEC",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.tecconcursos.com.br/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tecconcursos.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lidialemos4267-ai.github.io/*", "file:///*"],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
